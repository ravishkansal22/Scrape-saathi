# ==============================================================================
# ScrapSetu — Environment Configuration Template (.env.example)
# ==============================================================================
# NOTE: Copy this file to .env for local development. Never commit real secrets
# or .env files to version control.
#
# IMPORTANT ON AWS CREDENTIALS:
# AWS credentials must NOT be hardcoded in environment files or source code.
# Provide AWS credentials via IAM roles (in deployed environments), the AWS SSO
# CLI / credential helper, or local named AWS profiles (~/.aws/credentials).
# ==============================================================================

# Application Settings
APP_NAME=ScrapSetu
APP_ENV=development
LOG_LEVEL=info
DEBUG=true

# Server Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=3000
CORS_ORIGINS=http://localhost:3000

# Database Configuration (PostgreSQL with PostGIS)
DATABASE_URL=postgresql://user:password@localhost:5432/scrapsetudb

# Authentication (Amazon Cognito / Local Auth)
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_REGION=

# AWS Core Configuration
AWS_REGION=us-east-1
AWS_S3_BUCKET=
AWS_SQS_EVENT_QUEUE_URL=
AWS_EVENTBRIDGE_BUS_NAME=

# AWS AI & Machine Learning Services
BEDROCK_MODEL_ID=anthropic.claude-3-sonnet-20240229-v1:0
SAGEMAKER_ENDPOINT_NAME=

# AWS IoT Core (Smart-Bin Telemetry)
AWS_IOT_ENDPOINT=
AWS_IOT_CLIENT_ID=scrapsetu-collector-service
