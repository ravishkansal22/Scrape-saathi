# ==============================================================================
# ScrapSetu — Environment Configuration Template (.env.example)
# ==============================================================================
# NOTE: Copy this file to .env for local development:
#   cp .env.example .env
# Never commit actual secret keys or production .env files to version control.
# ==============================================================================

# Application Settings
APP_NAME=ScrapSetu
APP_ENV=development
LOG_LEVEL=info
DEBUG=true

# Server & Network Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=3000
CORS_ORIGINS=http://localhost:3000

# ------------------------------------------------------------------------------
# 1. AWS IAM Credentials & Region
# Purpose: Grants permission to invoke AWS cloud services (Bedrock, S3, IoT Core).
# How to obtain: Generated in AWS IAM Console -> Security Credentials.
# ------------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# ------------------------------------------------------------------------------
# 2. Amazon Bedrock (LLM / Vision)
# Purpose: Powers zero-shot multimodal visual scrap decomposition and hazard identification.
# How to obtain: Enabled in AWS Bedrock Console -> Model Access.
# ------------------------------------------------------------------------------
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# ------------------------------------------------------------------------------
# 3. Amazon S3 Storage
# Purpose: Stores user-uploaded scrap photos via pre-signed URLs and generates audit PDFs.
# How to obtain: Created in AWS S3 Console.
# ------------------------------------------------------------------------------
AWS_S3_BUCKET=scrapsetudb-scrap-images

# ------------------------------------------------------------------------------
# 4. AWS IoT Core (Smart-Bin Telemetry)
# Purpose: Ingests MQTT telemetry packets published by smart bin sensors over TLS/X.509.
# How to obtain: Found in AWS IoT Core Console -> Settings.
# ------------------------------------------------------------------------------
AWS_IOT_ENDPOINT=a3xxxxxxx-ats.iot.us-east-1.amazonaws.com
AWS_IOT_CLIENT_ID=scrapsetu-collector-service

# ------------------------------------------------------------------------------
# 5. Cryptographic QR Secret
# Purpose: Signs dynamic QR code payloads using HMAC-SHA256 for dual-key handover.
# How to obtain: Configured locally in .env (Any secure string / random secret).
# ------------------------------------------------------------------------------
SECRET_KEY=change-this-to-a-secure-random-secret-key-for-hmac-sha256

# ------------------------------------------------------------------------------
# 6. PostgreSQL + PostGIS (Optional / Local Ledger)
# Purpose: Relational database ledger managing digital waste lots and spatial queries (ST_DWithin).
# How to obtain: Local Docker PostgreSQL or AWS RDS for PostgreSQL.
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://user:pass@localhost:5432/scrapsetudb

# ------------------------------------------------------------------------------
# Additional AWS & Auth Configurations (Optional)
# ------------------------------------------------------------------------------
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_REGION=us-east-1
AWS_SQS_EVENT_QUEUE_URL=
AWS_EVENTBRIDGE_BUS_NAME=
SAGEMAKER_ENDPOINT_NAME=
