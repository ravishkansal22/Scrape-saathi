# Copy to backend/.env. The backend does not load a root .env.
APP_ENV=development
AUTH_MODE=local
STORE_BACKEND=sqlite
LOCAL_DEMO_PASSWORD=scrapsetu-local
# Blank in local mode creates a stable private key in backend/data.
SECRET_KEY=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
# Recommended: named AWS CLI profile (configure outside this file).
# AWS_PROFILE=scrapsetu
# Alternative temporary credentials; never put these in frontend/.env.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
AWS_S3_BUCKET=
DYNAMODB_TABLE=
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_DOMAIN=
POLLY_ENABLED=false
LOCATION_ENABLED=false
AWS_IOT_ENDPOINT=
AWS_IOT_TOPIC=scrapsetu/bins
# DATA_DIR=/absolute/path/to/persistent/data
